{
  "root": ".",
  "clean_urls": true,
  "routes": {
    "/styles/*": "styles/",
    "/scripts/*": "scripts/",
    "/style.css": "style.css",
    "/**": "index.html"
  },
  "headers": {
    "/**": {
      "Cache-Control": "public, max-age=0, must-revalidate"
    },
    "/**.css": {
      "Cache-Control": "public, max-age=31536000, immutable",
      "Content-Type": "text/css"
    },
    "/**.js": {
      "Cache-Control": "public, max-age=31536000, immutable"
    }
  }
} 